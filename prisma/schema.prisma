generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String       @id @default(uuid())
  email    String       @unique
  password String
  role     Role
  profile  UserProfile?
  student  Student?
  teacher  Teacher?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

model UserProfile {
  id        String  @id @default(uuid())
  userId    String  @unique
  firstName String
  lastName  String
  phone     String?
  gender    Gender
  user      User    @relation(fields: [userId], references: [id])
}

model Student {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  enrollments Enrollment[]
}

model Teacher {
  id      String  @id @default(uuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id])
  classes Class[]
}

model Course {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?
  classes     Class[]

  @@map("courses")
}

model Class {
  id          String       @id @default(uuid())
  name        String
  courseId    String
  teacherId   String
  startDate   DateTime
  endDate     DateTime?
  course      Course       @relation(fields: [courseId], references: [id])
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  enrollments Enrollment[]
  lessons     Lesson[]
  assignments Assignment[]

  @@map("classes")
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  classId   String
  grade     String?
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id])
  class     Class    @relation(fields: [classId], references: [id])

  @@unique([studentId, classId]) // prevent duplicate enroll
  @@index([studentId])
  @@index([classId])
  @@map("enrollments")
}

model Lesson {
  id        String   @id @default(uuid())
  classId   String
  title     String
  content   String? // markdown / text
  videoUrl  String?
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])

  @@map("lessons")
}

model Assignment {
  id        String   @id @default(uuid())
  classId   String
  title     String
  dueDate   DateTime
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])

  @@map("assignments")
}

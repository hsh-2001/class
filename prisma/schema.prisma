generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model School {
  id      String   @id @default(uuid())
  name    String
  users   User[]
  courses Course[]
  classes Class[]

  @@map("schools")
}

model User {
  id                     String          @id @default(uuid())
  schoolId               String          @map("school_id")
  school                 School          @relation(fields: [schoolId], references: [id])
  username               String          @default("")
  email                  String
  password               String
  role                   Role
  profile                UserProfile?
  student                Student?
  teacher                Teacher?
  sentMessages           Message[]
  messageThreadsAsFirst  MessageThread[] @relation("MessageThreadParticipantOne")
  messageThreadsAsSecond MessageThread[] @relation("MessageThreadParticipantTwo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([email, username, schoolId])
  @@map("users")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

model UserProfile {
  id          String  @id @default(uuid())
  userId      String  @unique @map("user_id")
  firstName   String  @map("first_name")
  lastName    String  @map("last_name")
  phone       String?
  gender      Gender
  profile_url String? @map("profile_url")

  user User @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model Student {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  user User @relation(fields: [userId], references: [id])

  enrollments    Enrollment[]
  messageThreads MessageThread[]

  @@map("students")
}

model Teacher {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  user User @relation(fields: [userId], references: [id])

  classes        Class[]
  messageThreads MessageThread[]

  @@map("teachers")
}

model Course {
  id           String  @id @default(uuid())
  name         String
  code         String  @unique
  courseBanner String? @map("course_banner")
  description  String?

  classes         Class[]
  school          School?          @relation(fields: [schoolId], references: [id])
  schoolId        String?
  courseMaterials CourseMaterial[]

  @@map("courses")
}

model CourseMaterial {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  course    Course   @relation(fields: [courseId], references: [id])
  title     String
  content   String?
  videoUrl  String?  @map("video_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("course_materials")
}

model Class {
  id        String    @id @default(uuid())
  name      String
  courseId  String    @map("course_id")
  teacherId String    @map("teacher_id")
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  course  Course  @relation(fields: [courseId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  enrollments    Enrollment[]
  lessons        Lesson[]
  assignments    Assignment[]
  messageThreads MessageThread[]
  school         School?         @relation(fields: [schoolId], references: [id])
  schoolId       String?

  @@map("classes")
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  classId   String   @map("class_id")
  grade     String?
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
  @@index([studentId])
  @@index([classId])
  @@map("enrollments")
}

model Lesson {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  title     String
  content   String?
  videoUrl  String?  @map("video_url")
  createdAt DateTime @default(now()) @map("created_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model Assignment {
  id        String   @id @default(uuid())
  classId   String   @map("class_id")
  title     String
  dueDate   DateTime @map("due_date")
  createdAt DateTime @default(now()) @map("created_at")

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("assignments")
}

model MessageThread {
  id                   String   @id @default(uuid())
  classId              String?  @map("class_id")
  teacherId            String?  @map("teacher_id")
  studentId            String?  @map("student_id")
  participantOneUserId String?  @map("participant_one_user_id")
  participantTwoUserId String?  @map("participant_two_user_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  class          Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher        Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  student        Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  participantOne User?    @relation("MessageThreadParticipantOne", fields: [participantOneUserId], references: [id], onDelete: Cascade)
  participantTwo User?    @relation("MessageThreadParticipantTwo", fields: [participantTwoUserId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@unique([classId, teacherId, studentId])
  @@unique([participantOneUserId, participantTwoUserId])
  @@index([teacherId])
  @@index([studentId])
  @@index([classId])
  @@index([participantOneUserId])
  @@index([participantTwoUserId])
  @@map("message_threads")
}

model Message {
  id               String    @id @default(uuid())
  threadId         String    @map("thread_id")
  senderUserId     String    @map("sender_user_id")
  replyToMessageId String?   @map("reply_to_message_id")
  isForwarded      Boolean   @default(false) @map("is_forwarded")
  content          String    @default("")
  imageUrl         String?   @map("image_url")
  attachments      Json?     @map("attachments")
  createdAt        DateTime  @default(now()) @map("created_at")

  thread          MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderUser      User          @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  replyToMessage  Message?      @relation("MessageReplyChain", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies         Message[]     @relation("MessageReplyChain")

  @@index([threadId])
  @@index([senderUserId])
  @@index([replyToMessageId])
  @@map("messages")
}
